{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-foodocopoeia",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/*"]
  },
  "observability": { "enabled": true }
}
