{
  "name": "open-foodocopoeia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "python3 tools/build_public_dataset.py",
    "check": "npm run check:worker && npm run test:worker && python3 -m unittest discover -s tests -p 'test_*.py'",
    "check:worker": "tsc --noEmit",
    "test:worker": "tsx --test tests/*.test.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
